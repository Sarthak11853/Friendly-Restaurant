# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "Publishable" key (or the legacy "anon" key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# "Secret" key (or the legacy "service_role" key). Server only, never expose it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optional: Google Places API (New) key for better restaurant search.
# Leave empty to use free OpenStreetMap search.
GOOGLE_MAPS_API_KEY=

# Push notifications (reminders + friend requests).
# Generate a key pair with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=mailto:you@example.com

# Protects /api/cron/reminders. Any long random string, e.g.:  openssl rand -hex 32
CRON_SECRET=
